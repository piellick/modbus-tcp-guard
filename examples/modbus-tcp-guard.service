# /etc/systemd/system/modbus-tcp-guard.service
[Unit]
Description=modbus-tcp-guard (read-only by default proxy in front of a Modbus TCP gateway)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/default/modbus-tcp-guard
ExecStart=/usr/bin/python3 /usr/local/bin/modbus_tcp_guard.py
DynamicUser=yes
# Needed only because the default port (502) is below 1024
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
