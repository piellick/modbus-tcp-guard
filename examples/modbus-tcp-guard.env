# /etc/default/modbus-tcp-guard

# Modbus TCP gateway to protect (host:port)
TARGET=192.168.0.4:502
# Port the guard listens on
LISTEN_PORT=502
# Client IPs allowed to connect (comma-separated). Everyone else is dropped.
ALLOWED_CLIENTS=192.168.1.10,192.168.1.20

# 0 = read-only (function codes 1-4 only). This is the default.
WRITE_ENABLED=0
# The three lines below only matter when WRITE_ENABLED=1.
# Client IPs allowed to write (subset of ALLOWED_CLIENTS)
#WRITE_CLIENTS=192.168.1.10
# register:min-max, comma-separated. Only "write single register" (function 6)
# is forwarded, only to these registers, only with a value inside the range.
#WRITE_REGISTERS=5061:160-220,5072:160-220

# Seconds to wait for the gateway
#TIMEOUT=5
